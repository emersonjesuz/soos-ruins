// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id        String   @id @default(uuid())
  name      String
  level     Int
  position  String
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("players")
}
